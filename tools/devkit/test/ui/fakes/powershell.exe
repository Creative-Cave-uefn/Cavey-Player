#!/usr/bin/env bash
# Test double for Windows PowerShell used by the UI snapshot tests.
# "-Command <line>" runs the line in bash; "-File engine.ps1 /build ..." prints
# a short failing build with DevKit stage markers.
for arg in "$@"; do last="$arg"; done
if printf '%s\n' "$@" | grep -qx -- "-Command"; then exec bash -c "$last"; fi
if printf '%s\n' "$@" | grep -qx -- "--json"; then
  # Data commands run the real engine under PowerShell 7 (git is real, gh is the fake).
  args=(); skip=0
  for a in "$@"; do
    if [ "$skip" = 1 ]; then skip=0; continue; fi
    case "$a" in -NoLogo|-NoProfile|-NonInteractive) ;; -ExecutionPolicy) skip=1 ;; *) args+=("$a") ;; esac
  done
  exec pwsh -NoProfile "${args[@]}"
fi
if printf '%s\n' "$@" | grep -qx -- "/run"; then echo "  ✓ Cavey 0.4.0.7 started"; exit 0; fi
if printf '%s\n' "$@" | grep -qx -- "feature/alpha" && printf '%s\n' "$@" | grep -qx -- "--local"; then
  # A successful local build with a result marker for the build card.
  for stage in source prepare checks compile package; do
    echo "@@CAVEY_STAGE|$stage|running|$stage"; sleep 0.4; echo "@@CAVEY_STAGE|$stage|done|$stage"
  done
  echo "@@CAVEY_STAGE|verify|done|Started as 0.4.0.7"
  echo "@@CAVEY_STAGE|publish|skipped|Local-only build"
  echo '@@CAVEY_RESULT|{"id":"run7","status":"built","folder":"/tmp/devkit-ui-run7","version":"0.4.0.7","channel":"devkit/alpha","tag":"test-devkit-alpha-v0.4.0.7","local":true,"source":"feature/alpha","url":"","artifacts":[{"name":"CavePlayer-Setup.exe","size":50593792},{"name":"CavePlayer-portable.zip","size":63963136}]}'
  echo "  ✓ built · /tmp/devkit-ui-run7"
  exit 0
fi
echo "Build plan"
echo "@@CAVEY_STAGE|source|running|Prepare source checkout"; sleep 0.3
echo "@@CAVEY_STAGE|source|done|Source checkout ready"
echo "@@CAVEY_STAGE|prepare|running|Prepare Windows project"
for n in $(seq 1 30); do echo "Resolving dependencies $n"; done
echo "@@CAVEY_STAGE|prepare|done|Windows project prepared"
echo "@@CAVEY_STAGE|checks|skipped|Checks skipped on request"
echo "@@CAVEY_STAGE|compile|running|Compile Flutter Windows"; sleep 1.5
echo "ERROR: lib/main.dart:12:3: Undefined name 'foo'"
for n in $(seq 1 10); do echo "Build step $n"; done
echo "@@CAVEY_STAGE|compile|failed|Compile failed"
echo "DevKit engine error: Windows build failed with exit code 1." >&2
exit 1
